# AI Employee Vault - Gold Tier Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# =============================================================================
# CORE AI SERVICES
# =============================================================================

# Anthropic Claude API (Required for AI routing and task processing)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here

# OpenAI API (Optional - for additional AI capabilities)
# OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# =============================================================================
# ODOO ERP INTEGRATION (Gold Tier Requirement)
# =============================================================================

# Odoo ERP Server Configuration
ODOO_URL=http://localhost:8069
ODOO_DB=your_odoo_database_name
ODOO_USERNAME=your_odoo_username
ODOO_PASSWORD=your_odoo_password

# =============================================================================
# GOOGLE SERVICES INTEGRATION
# =============================================================================

# Google Calendar API
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TOKEN_PATH=token.json

# Note: Gmail integration uses OAuth2 file-based authentication
# Place your Google OAuth credentials in: integrations/gmail/credentials.json
# The token will be automatically saved to: integrations/gmail/token.json

# =============================================================================
# SOCIAL MEDIA PLATFORMS
# =============================================================================

# Facebook/Meta Graph API
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token

# Instagram Business API (requires Facebook page connection)
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# X (Twitter) API v2
X_API_KEY=your_twitter_api_key
X_API_SECRET=your_twitter_api_secret
X_ACCESS_TOKEN=your_twitter_access_token
X_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# LinkedIn API (for LinkedIn Watcher)
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_ID=your_linkedin_person_id

# =============================================================================
# BANK API (for Finance Watcher)
# =============================================================================

# Supported providers: plaid, stripe, custom
BANK_API_PROVIDER=plaid
BANK_API_KEY=your_bank_api_key
BANK_API_SECRET=your_bank_api_secret
BANK_ACCOUNT_ID=your_bank_account_id
# BANK_API_URL=your_custom_bank_api_url  # Only for 'custom' provider

# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================

# MCP Server Ports (default configuration)
# Email MCP: Port 8001
# LinkedIn MCP: Port 8001 (standalone) / Social Media MCP: Port 8004 (unified)
# Odoo MCP: Port 8003
# Facebook MCP: Port 8005
# Instagram MCP: Port 8006
# X MCP: Port 8007
# Browser MCP: Port 8008
# Calendar MCP: Port 8009

# =============================================================================
# BROWSER AUTOMATION (Payment Portals)
# =============================================================================

# Playwright configuration for browser automation
# PLAYWRIGHT_BROWSERS_PATH=/path/to/browsers (optional)

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# Logging Level
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development

# Vault Base Path (auto-detected if not specified)
# VAULT_BASE_PATH=/path/to/your/vault

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Encryption key for sensitive data (generate a secure random key)
# ENCRYPTION_KEY=your-32-character-encryption-key

# Session timeout in minutes
SESSION_TIMEOUT=60

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Debug mode
DEBUG=true

# Enable verbose logging
VERBOSE_LOGGING=false

# Test mode (uses mock services when true)
TEST_MODE=false

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================

# Email notifications (optional)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================

# Backup frequency in hours
BACKUP_FREQUENCY=24

# Log retention in days
LOG_RETENTION_DAYS=90

# =============================================================================
# INSTRUCTIONS FOR SETUP
# =============================================================================

# 1. Copy this file to .env
# 2. Fill in your actual API keys and credentials
# 3. Set up Google OAuth credentials for Gmail/Calendar
# 4. Configure your Odoo ERP connection
# 5. Set up social media API access
# 6. Ensure all required services are running
# 7. Test the configuration with: python -m orchestration.run_system --test

# =============================================================================
# API KEY SOURCES
# =============================================================================

# Anthropic Claude: https://console.anthropic.com/
# OpenAI: https://platform.openai.com/api-keys
# Google Cloud Console: https://console.cloud.google.com/
# Facebook Developers: https://developers.facebook.com/
# Instagram Basic Display: https://developers.facebook.com/docs/instagram-basic-display-api
# Twitter Developer Portal: https://developer.twitter.com/
# Odoo: Your Odoo instance admin panel

# =============================================================================
# SECURITY NOTES
# =============================================================================

# - Never commit .env file to version control
# - Rotate API keys regularly
# - Use environment-specific configurations
# - Enable 2FA on all service accounts
# - Monitor API usage and rate limits
# - Keep credentials secure and encrypted